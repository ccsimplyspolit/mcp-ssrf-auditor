{
  "tools": [
    {
      "name": "lookup_status",
      "description": "Lookup health status of sanctioned production endpoints.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["auth", "billing", "notifications"],
            "description": "Name of the target service"
          }
        },
        "required": ["service"]
      }
    },
    {
      "name": "read_report",
      "description": "Read generated sanitized report by report ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "report_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "description": "UUID of the report to display"
          }
        },
        "required": ["report_id"]
      }
    }
  ]
}
